# Files that must not reach a customer's plugins directory.
#
# This is a denylist, so it only excludes what someone thought to name here.
# bin/build-release.sh therefore builds from git's tracked files and applies
# this on top: anything untracked cannot ship even if it is missing below.

# Version control and editor state
.git
.gitignore
.gitattributes
.distignore
.idea
.vscode
.claude
.DS_Store

# Dependencies and build output
vendor
node_modules
build
dist

# Development tooling and tests
tests
bin
composer.json
composer.lock
phpcs.xml.dist
phpstan.neon.dist
phpunit.xml.dist
.phpunit.cache
.phpunit.result.cache

# Repository-only files; readme.txt is the one the directory reads
CLAUDE.md
RELEASE-CHECKLIST.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
.github
.wordpress-org

# Generated for the marketing site; customers have no use for it
tool-surface.json
