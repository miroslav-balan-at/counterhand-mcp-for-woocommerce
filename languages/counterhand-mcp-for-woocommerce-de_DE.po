#: src/Features/OAuth/View/FlowPage.php:93
msgid "Connection problem"
msgstr "Verbindungsproblem"

#. translators: %s: name of the AI application
#: src/Features/OAuth/View/templates/connected.php:32
#, php-format
msgid "%s may now use your store with the permissions below."
msgstr "%s darf deinen Shop jetzt mit den unten aufgeführten Berechtigungen nutzen."

#: src/Features/OAuth/View/templates/connected.php:46
msgid "Return to your AI assistant to finish connecting. You can close this tab."
msgstr "Kehre zu deinem KI-Assistenten zurück, um die Verbindung abzuschließen. Du kannst diesen Tab schließen."

#: src/Features/OAuth/View/templates/consent.php:28
msgid "An app asks to connect"
msgstr "Eine App möchte sich verbinden"

#. translators: %s: name the app gives itself, e.g. "Claude".
#: src/Features/OAuth/View/templates/consent.php:33
#, php-format
msgid "Let %s work with your store?"
msgstr "Darf %s mit deinem Shop arbeiten?"

#: src/Features/OAuth/View/templates/consent.php:38
msgid "It can do what you tick below, and nothing else. You can take its access away at any time."
msgstr "Sie kann tun, was du unten ankreuzt, und sonst nichts. Du kannst ihr den Zugriff jederzeit wieder entziehen."

#: src/Features/OAuth/View/templates/consent.php:46
msgid "Approving as"
msgstr "Genehmigung als"

#: src/Features/OAuth/View/templates/consent.php:57
msgid "Address verified"
msgstr "Adresse geprüft"

#: src/Features/OAuth/View/templates/consent.php:61
msgid "Access goes to"
msgstr "Der Zugriff geht an"

#: src/Features/OAuth/View/templates/consent.php:67
msgid "This hands access to a program on your own computer. Approve only if you just started this connection yourself: any program there could ask under this app's name."
msgstr "Damit erhält ein Programm auf deinem eigenen Computer Zugriff. Genehmige nur, wenn du diese Verbindung gerade selbst gestartet hast: Jedes Programm dort könnte unter dem Namen dieser App anfragen."

#: src/Features/OAuth/View/templates/consent.php:80
msgid "Nothing this app asked for is currently switched on for this store, so there is nothing to approve yet."
msgstr "Nichts von dem, was diese App angefragt hat, ist für diesen Shop derzeit eingeschaltet — es gibt also noch nichts zu genehmigen."

#: src/Features/OAuth/View/templates/consent.php:85
msgid "Choose what it may do"
msgstr "Wähle, was sie tun darf"

#. translators: 1: how many permissions in this section can be granted, 2: how many it has.
#: src/Features/OAuth/View/templates/consent.php:101
#, php-format
msgid "%1$s of %2$s can be granted"
msgstr "%1$s von %2$s können gewährt werden"

#: src/Features/OAuth/View/templates/consent.php:116
msgid "Uncheck anything you would rather not grant. You can revoke the whole connection later."
msgstr "Entferne den Haken bei allem, was du lieber nicht gewähren möchtest. Du kannst die gesamte Verbindung später widerrufen."

#. translators: 1: link to the Access screen, named as in the menu, e.g. "Counterhand MCP › Access".
#: src/Features/OAuth/View/templates/consent.php:123
#, php-format
msgid "Grayed-out areas are switched off for this store. Switch them on under %1$s, then connect the app again — a connection only ever holds what it was approved with."
msgstr "Ausgegraute Bereiche sind für diesen Shop ausgeschaltet. Schalte sie unter %1$s ein und verbinde die App dann erneut — eine Verbindung behält immer nur, was bei ihrer Genehmigung freigegeben wurde."

#: src/Features/OAuth/View/templates/consent.php:132
msgid "This request includes permission to change store data. New products are always created as drafts for you to review."
msgstr "Diese Anfrage umfasst die Berechtigung, Shop-Daten zu ändern. Neue Produkte werden immer als Entwürfe angelegt, damit du sie prüfen kannst."

#: src/Features/OAuth/View/templates/consent.php:145
msgid "Approve access"
msgstr "Zugriff genehmigen"

#: src/Features/OAuth/View/templates/consent.php:149
msgid "Return to the app"
msgstr "Zurück zur App"

#: src/Features/OAuth/View/templates/consent.php:149
msgid "Deny"
msgstr "Ablehnen"

#. translators: %s: where connected apps are listed in the menu, e.g. "Counterhand MCP › Connect apps › Connected apps".
#: src/Features/OAuth/View/templates/consent.php:159
#, php-format
msgid "You can take this app's access away any time under %s."
msgstr "Du kannst dieser App den Zugriff jederzeit unter %s wieder entziehen."

#. translators: %s: name of the AI application
#: src/Features/OAuth/View/templates/denied.php:30
#, php-format
msgid "You declined the request from %s. Nothing was shared and no connection was created."
msgstr "Du hast die Anfrage von %s abgelehnt. Es wurde nichts geteilt und keine Verbindung erstellt."

#: src/Features/OAuth/View/templates/denied.php:36
msgid "You can close this tab. If you meant to allow it, start the connection again from your AI assistant."
msgstr "Du kannst diesen Tab schließen. Wenn du den Zugriff eigentlich erlauben wolltest, starte die Verbindung erneut aus deinem KI-Assistenten."

#: src/Features/OAuth/View/templates/error.php:29
msgid "Nothing was connected. Try starting the connection again from your AI assistant."
msgstr "Es wurde nichts verbunden. Starte die Verbindung erneut aus deinem KI-Assistenten."

#: src/Features/OAuth/View/templates/error.php:33
msgid "Connection help"
msgstr "Hilfe zur Verbindung"

#. translators: %d: how many actions the approval covers.
#: src/Features/OAuth/View/templates/partial-consent-rows.php:27
#, php-format
msgid "Approves %d action. Actions this plugin adds later stay off until you connect again."
msgid_plural "Approves %d actions. Actions this plugin adds later stay off until you connect again."
msgstr[0] "Genehmigt %d Aktion. Aktionen, die dieses Plugin später hinzufügt, bleiben aus, bis du erneut verbindest."
msgstr[1] "Genehmigt %d Aktionen. Aktionen, die dieses Plugin später hinzufügt, bleiben aus, bis du erneut verbindest."

