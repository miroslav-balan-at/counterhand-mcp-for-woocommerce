msgstr "für den Chat verfügbar"

#. translators: %d: the most tools one message can carry.
#: src/Features/Playground/views/partial-chat-tools.php:53
#, php-format
msgid "over the %d-tool limit"
msgstr "über dem Limit von %d Tools"

#. translators: %d: how many further tools are waiting on a store setting.
#: src/Features/Playground/views/partial-chat-tools.php:63
