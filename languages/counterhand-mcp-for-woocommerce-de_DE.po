msgstr "Kann Daten ändern"

#. translators: %s: store name
#: src/Features/OAuth/View/templates/shell.php:60
#, php-format
msgid "Back to %s"
msgstr "Zurück zu %s"

#: src/Features/OAuth/View/templates/shell.php:66
