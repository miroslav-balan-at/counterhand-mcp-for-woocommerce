{
	"name": "counterhand-mcp-for-woocommerce-e2e",
	"private": true,
	"description": "End-to-end test tooling only, run against the disposable devbox store in tests/e2e/store. Nothing here is built into or shipped with the plugin.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"e2e:store:start": "devbox services up -b -c tests/e2e/store",
		"e2e:store:stop": "devbox services stop -c tests/e2e/store",
		"e2e:store:install": "devbox run -c tests/e2e/store install-store",
		"e2e": "playwright test",
		"e2e:report": "playwright show-report \"${COUNTERHAND_E2E_STATE_DIR:-$HOME/.cache/counterhand-e2e}/report\""
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "22.20.4"
	}
}
