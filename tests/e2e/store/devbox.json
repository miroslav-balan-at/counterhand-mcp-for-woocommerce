{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "php": {
      "version": "8.3",
      "disable_plugin": true
    },
    "wp-cli": {
      "version": "latest"
    },
    "mariadb": {
      "version": "10.5",
      "disable_plugin": true
    },
    "nginx": {
      "version": "latest",
      "disable_plugin": true
    },
    "process-compose": {
      "version": "latest"
    },
    "gettext": {
      "version": "latest"
    },
    "php83Extensions.opcache": {
      "version": "latest"
    },
    "php83Extensions.mysqli": {
      "version": "latest"
    },
    "php83Extensions.pdo_mysql": {
      "version": "latest"
    },
    "php83Extensions.intl": {
      "version": "latest"
    },
    "php83Extensions.zip": {
      "version": "latest"
    },
    "php83Extensions.gd": {
      "version": "latest"
    }
  },
  "shell": {
    "init_hook": [
      ". \"$DEVBOX_PROJECT_ROOT/scripts/setup-env.sh\""
    ],
    "scripts": {
      "install-store": "bash \"$DEVBOX_PROJECT_ROOT/scripts/install-store.sh\""
    }
  },
  "services": {
    "process_compose_file": "process-compose.yaml"
  }
}
